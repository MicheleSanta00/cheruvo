# Copia questo file in ".env" e riempi i valori.
# Il file .env è già ignorato da git: le chiavi non finiscono mai nel repo.
#
# I secret di GitHub non si possono rileggere una volta salvati. I valori
# però sono visibili su Render, nella scheda Environment del servizio backend.

# ── Indispensabili per l'aggiornamento news ──────────────────────────────────
DATABASE_URL=
ALPHA_VANTAGE=
GROQ_API_KEY=

# ── Servono solo per gli alert email ai Pro (senza, il resto funziona) ───────
RESEND_API_KEY=
FROM_EMAIL=
FRONTEND_URL=https://app.cheruvo.com

# ── Facoltativi ──────────────────────────────────────────────────────────────
# Modello usato per assegnare lo score alle news
GROQ_SCORE_MODEL=llama-3.1-8b-instant
# Fonte GDELT: lasciala vuota o a 0 finché non hai validato la qualità
GDELT_ENABLED=
